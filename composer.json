{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mattmy/laravel-attribute-mapper",
    "description": "Map selected Laravel input to fillable Eloquent model attributes.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "ramsey/uuid": "^4.7.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.8.0|^11.0",
        "phpstan/phpstan": "^2.1.3",
        "phpunit/phpunit": "^11.5.50|^12.5",
        "symfony/translation": "^7.4.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Mattmy\\FillMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mattmy\\FillMap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mattmy\\FillMap\\AttributeMapperServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "format:check": "pint --test",
        "check": [
            "composer validate --strict",
            "composer check-platform-reqs",
            "@format:check",
            "@analyse",
            "@test",
            "composer audit"
        ]
    },
    "prefer-stable": true
}
